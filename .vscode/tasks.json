{
    // =========================================================================
    // .vscode/tasks.json — VSCode task definitions
    // =========================================================================
    // These tasks integrate VSCode with the Streamlit Development Machine CLI.
    // They are the bridge between the VSCode UI/keyboard shortcuts and the
    // Python process manager (sds/streamlit/daemon.py).
    //
    // HOW TO RUN A TASK:
    //   - Press Ctrl+Shift+P → "Tasks: Run Task" → choose a task
    //   - Ctrl+Shift+B → runs the default task (Streamlit: Start)
    //   - Each task opens in a dedicated terminal panel
    //
    // NOTE: This file is auto-regenerated by sds/setup/vscode_setup.py
    //       during setup. Any manual edits may be overwritten.
    // =========================================================================
    "version": "2.0.0",
    "tasks": [
        {
            // ─────────────────────────────────────────────────────────────────
            // Start Streamlit dev server (also the default Ctrl+Shift+B task)
            // ─────────────────────────────────────────────────────────────────
            "label": "Streamlit: Start",
            "type": "shell",
            "command": "python main.py streamlit start",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            },
            "problemMatcher": [],
            "detail": "Start the Streamlit development server (single instance)"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Stop the running Streamlit process via the PID file
            // ─────────────────────────────────────────────────────────────────
            "label": "Streamlit: Stop",
            "type": "shell",
            "command": "python main.py streamlit stop",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Stop the running Streamlit dev server"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Restart: stop + start in one step
            // ─────────────────────────────────────────────────────────────────
            "label": "Streamlit: Restart",
            "type": "shell",
            "command": "python main.py streamlit restart",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Restart the Streamlit dev server"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Attach: open a terminal streaming live Streamlit output
            // ─────────────────────────────────────────────────────────────────
            "label": "Streamlit: Attach (live logs)",
            "type": "shell",
            "command": "python main.py attach",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": false
            },
            "problemMatcher": [],
            "detail": "Stream live output from the running Streamlit process"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Start Everything: tunnel + Streamlit
            // ─────────────────────────────────────────────────────────────────
            "label": "Dev Machine: Start All",
            "type": "shell",
            "command": "python main.py start",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            },
            "problemMatcher": [],
            "detail": "Start VSCode tunnel + Streamlit dev server"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Stop Everything
            // ─────────────────────────────────────────────────────────────────
            "label": "Dev Machine: Stop All",
            "type": "shell",
            "command": "python main.py stop",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Stop VSCode tunnel + Streamlit dev server"
        },
        {
            // ─────────────────────────────────────────────────────────────────
            // Status dashboard
            // ─────────────────────────────────────────────────────────────────
            "label": "Dev Machine: Status",
            "type": "shell",
            "command": "python main.py status",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Show status of all managed services"
        }
    ]
}
