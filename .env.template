# =============================================================================
# Streamlit Development Machine — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
# Most values here are populated automatically by the onboarding wizard.
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTITY LOCK
# These are set automatically during onboarding. Do NOT edit manually.
# The MACHINE_FINGERPRINT is a SHA-256 hash derived from your hardware +
# username + passphrase. If it doesn't match on startup, the tool refuses to run.
# -----------------------------------------------------------------------------
MACHINE_FINGERPRINT=
ALLOWED_USER=

# -----------------------------------------------------------------------------
# GIT CONFIGURATION
# The repo that will be cloned and used for Streamlit development.
# GIT_TOKEN is a GitHub Personal Access Token with repo read access.
# GIT_REPO_URL supports both HTTPS and SSH formats.
# -----------------------------------------------------------------------------
GIT_USERNAME=
GIT_EMAIL=
GIT_TOKEN=
GIT_REPO_URL=
GIT_BRANCH=main

# Folder where the repo will be cloned (relative to project root)
REPO_FOLDER=./repo

# -----------------------------------------------------------------------------
# STREAMLIT DEVELOPMENT SERVER
# STREAMLIT_DEV_FILE is the Python file inside REPO_FOLDER that streamlit runs.
# STREAMLIT_PORT is the local port Streamlit listens on.
# STREAMLIT_HOST is the address to bind to (0.0.0.0 exposes to network).
# -----------------------------------------------------------------------------
STREAMLIT_DEV_FILE=litdev.py
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# VSCODE TUNNEL
# VSCODE_TUNNEL_NAME is the name shown in vscode.dev when connecting.
# This must be unique across all tunnels in your Microsoft account.
# -----------------------------------------------------------------------------
VSCODE_TUNNEL_NAME=streamlit-dev-machine

# -----------------------------------------------------------------------------
# MICROSOFT AUTHENTICATION
# Used for VSCode tunnel authentication (device flow).
# MS_CLIENT_ID: your Azure app registration client ID.
# MS_TENANT_ID: your Azure tenant ID (use "common" for multi-tenant).
# These tokens are written here after a successful device-flow login.
# -----------------------------------------------------------------------------
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_ACCESS_TOKEN=
MS_REFRESH_TOKEN=
MS_TOKEN_EXPIRY=

# -----------------------------------------------------------------------------
# RUNTIME FLAGS
# DOCKER_MODE=true bypasses the identity fingerprint check (containers have
#   no stable hardware fingerprint).
# AUTO_START=true causes `python main.py` with no args to run `start`.
# LOG_LEVEL controls verbosity: DEBUG | INFO | WARNING | ERROR
# -----------------------------------------------------------------------------
DOCKER_MODE=false
AUTO_START=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PATHS (override if needed; defaults are relative to project root)
# -----------------------------------------------------------------------------
PID_FILE=.streamlit.pid
TUNNEL_PID_FILE=.tunnel.pid
SOCKET_FILE=.streamlit.sock
LOG_FILE=logs/streamlit.log
